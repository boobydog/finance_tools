PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# 5分ごとにjpx-importを起動する。
# 実際に処理を行うかどうか(新規実行/リトライ待機/スキップ)はbatch_logsの状態を見て
# scripts.batch_logger側で判定するため、ここでは単に頻度高く叩くだけでよい。
*/5 * * * * root cd /app && python main.py jpx-import >> /app/logs/jpx_import.log 2>&1

# 基礎指標(PER/PBR/ROE等)は決算でしか変わらないため1日1回で十分。
# 実行要否はbatch_logsの状態を見てscripts.batch_logger側で判定するため、
# ここでは頻度高く(1時間おき)叩くだけでよい。
0 * * * * root cd /app && python main.py fetch-fundamentals >> /app/logs/fetch_fundamentals.log 2>&1

# 決算発表日・その翌日にあたる銘柄だけを個別に更新する(数時間おき)。
0 */6 * * * root cd /app && python main.py fetch-earnings-day-fundamentals >> /app/logs/fetch_earnings_day_fundamentals.log 2>&1

# EDINETの有価証券報告書(新規・訂正)は1日1回の巡回で十分。
# 実行要否はbatch_logsの状態を見てscripts.batch_logger側で判定するため、
# ここでは頻度高く(1時間おき)叩くだけでよい。直近数日分を毎回スキャンし直すため
# 取りこぼしにも強い(取込済みのdoc_idはedinet_filings台帳でスキップされる)。
0 * * * * root cd /app && python main.py edinet-sync >> /app/logs/edinet_sync.log 2>&1

# 適時開示は当日中に複数件出ることもあるため、他バッチより頻度高く(30分おき)巡回する。
# 実行要否はbatch_logsの状態を見てscripts.batch_logger側で判定するため(実処理は2時間に
# 1回に自己抑制)、ここでは頻度高く叩くだけでよい。
*/30 * * * * root cd /app && python main.py sync-market-news >> /app/logs/market_news_sync.log 2>&1
