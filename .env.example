# docker-compose.yml が読み込む環境変数のテンプレート。
# コピーして .env を作成し、値を書き換えてください(.env はgit管理対象外)。
#   cp .env.example .env

# フロントエンド(NextAuth.js)の認証情報
NEXTAUTH_SECRET=change-me-nextauth-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# EDINET(金融庁の開示システム)APIキー。https://disclosure2.edinet-fsa.go.jp/ で無料登録して取得する。
EDINET_API_KEY=change-me-edinet-api-key
